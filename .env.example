# SQLite (arquivo local — um banco por deploy)
DATABASE_URL=file:./data/projeteus.db

# Sessão local (gere um valor aleatório longo)
SESSION_SECRET=troque-por-um-segredo-aleatorio

# API
PORT=8080
WEB_PORT=5173
# Origem do frontend (CORS + links públicos de convite)
WEB_ORIGIN=http://localhost:5173
# Opcional: sobrescreve a URL base dos links compartilháveis
# PUBLIC_APP_URL=http://localhost:5173

# Seed (npm run db:seed) — único usuário inicial
SEED_ADMIN_EMAIL=mateus@projeteus.local
SEED_ADMIN_NAME=Mateus
SEED_ADMIN_PASSWORD=projeteus
